# Copy to .env, fill in, and load it (or set these in your host's
# environment-variable settings). Never commit the filled-in version.

# Required. Whoever owns this key pays for every call the tool makes.
ANTHROPIC_API_KEY=sk-ant-...

# Where the usage ledger lives. Put this on a persistent volume in production —
# if it resets, so do your spend caps.
LEDGER_PATH=./ledger.db

# Documents in, results out. Point these at synced folders if you are using the
# shared-folder delivery route.
INBOX_DIR=./inbox
OUTBOX_DIR=./outbox

CLIENTS_FILE=./clients.yaml

# Optional. A Slack incoming webhook is the usual choice. You want to hear
# about a failure before the client does.
ALERT_WEBHOOK=

# Optional. POST results as JSON, for clients wired up via automation middleware.
DELIVERY_WEBHOOK=
